# ─── Required ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-from-botfather

# ─── LLM Provider (pick one) ──────────────────────────────────────────────────
PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# PROVIDER=openai
# OPENAI_API_KEY=sk-...

# ─── Web Search (pick one, optional) ─────────────────────────────────────────
# SERPAPI_KEY=your-serpapi-key          # https://serpapi.com (100 free/month)
# BRAVE_SEARCH_API_KEY=your-brave-key  # https://api.search.brave.com (2000 free/month)

# ─── Gateway ──────────────────────────────────────────────────────────────────
PORT=3000
WEBHOOK_SECRET=change_me_to_a_random_string

# ─── Storage ──────────────────────────────────────────────────────────────────
DB_PATH=./data/sessions.db
WORKSPACE=./workspace

# ─── Security ─────────────────────────────────────────────────────────────────
# Comma-separated Telegram user IDs to allowlist (leave empty to allow all)
# ALLOWED_USER_IDS=123456789,987654321

# Docker image for bash sandboxing
SANDBOX_IMAGE=alpine:latest

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
